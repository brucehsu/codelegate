{
  "name": "@codelegate/desktop",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "description": "Codelegate Desktop: a multi-session coding-agent workspace grouped by repository.",
  "author": "Szu-Kai (Bruce) Hsu <bruce@searchable.com>",
  "homepage": "https://github.com/brucehsu/codelegate",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "typecheck": "tsc -b tsconfig.json tsconfig.node.json --pretty false",
    "test": "vitest run",
    "native:build": "napi build --cwd native --release --platform --no-js --dts index.d.ts",
    "native:build:debug": "napi build --cwd native --platform --no-js --dts index.d.ts",
    "native:test": "cargo test --manifest-path native/Cargo.toml --features noop",
    "smoke": "electron out/main/index.js --smoke"
  },
  "devDependencies": {
    "@codelegate/shared": "workspace:*",
    "@napi-rs/cli": "^3.9.0",
    "@pierre/trees": "1.0.0-beta.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.453.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
