{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // See the note in tsconfig.json: keep build metadata out of `out/`.
    "outDir": ".tsbuild/node",
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "electron/**/*.ts",
    "native/index.d.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
