{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Never under `out/`: electron-builder ships `out/**`, so a `tsc -b` run
    // before packaging would otherwise leak `.tsbuildinfo` into the asar.
    "outDir": ".tsbuild/renderer",
    "noEmit": true,
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@codelegate/shared": ["../../packages/shared/src/index.ts"],
      "@codelegate/shared/icons": ["../../packages/shared/src/icons/index.ts"]
    }
  },
  "include": ["src", "electron/shared"],
  "references": [
    { "path": "../../packages/shared" }
  ]
}
